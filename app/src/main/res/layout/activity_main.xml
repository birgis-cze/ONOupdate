<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yellow">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================ -->
        <!-- HLAVIČKA – linka na pozadí, logo vlevo, "Nastavení" vpravo   -->
        <!-- ============================================================ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="57dp">

            <!-- Vrstva 1: Linka (natažená přes celou šířku, výška 57dp) -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:src="@drawable/logo_linka"
                android:scaleType="fitXY"
                android:contentDescription="Linka" />

            <!-- Vrstva 2: Logo vlevo + text vpravo (zarovnáno NAHORU) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="57dp"
                android:orientation="horizontal"
                android:gravity="top">

                <ImageView
                    android:layout_width="155dp"
                    android:layout_height="57dp"
                    android:src="@drawable/logo_text"
                    android:scaleType="fitCenter"
                    android:contentDescription="ONO text" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nastavení"
                    android:textSize="18sp"
                    android:textColor="@color/red"
                    android:textStyle="bold"
                    android:gravity="top|end"
                    android:paddingTop="12dp"
                    android:paddingEnd="8dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- ============================================================ -->
        <!-- SEKCE: ZOBRAZENÍ                                              -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zobrazení"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginTop="4dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_n95"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Natural 95"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_n95p"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Natural 95+"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_n98"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Natural 98"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_diesel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diesel"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_diesel_plus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diesel+"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_lpg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LPG"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_adblue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AdBlue"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_om"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Osobní myčka"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_nm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nákladní myčka"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_euro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EUR kurz"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- SEKCE: AKTUALIZACE                                            -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aktualizace"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginTop="4dp">

            <!-- ŠPIČKA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Špička - obvyklý čas aktualizace cen"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btn_peak_start_minus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="−"
                    android:textSize="20sp"
                    android:backgroundTint="@color/red"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tv_peak_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="14:30"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="60dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_peak_start_plus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:backgroundTint="@color/red"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btn_peak_end_minus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="−"
                    android:textSize="20sp"
                    android:backgroundTint="@color/red"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tv_peak_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16:00"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="60dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_peak_end_plus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:backgroundTint="@color/red"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <!-- INTERVALY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interval aktualizací špička / mimo špičku"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/red"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btn_peak_interval_minus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="−"
                    android:textSize="20sp"
                    android:backgroundTint="@color/red"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tv_peak_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="60dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_peak_interval_plus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:backgroundTint="@color/red"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <Button
                    android:id="@+id/btn_off_peak_interval_minus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="−"
                    android:textSize="20sp"
                    android:backgroundTint="@color/red"
                    android:layout_marginStart="8dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tv_off_peak_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="60dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_off_peak_interval_plus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:backgroundTint="@color/red"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

            <!-- VELIKOST TEXTU WIDGETU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp">

                <!-- Nadpis vlevo (přebere veškeré zbývající místo) -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Velikost textu widgetu:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/red" />

                <!-- Ovládací prvky vpravo -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">

                    <Button
                        android:id="@+id/btn_widget_text_minus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="−"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/red"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />

                    <TextView
                        android:id="@+id/tv_widget_text_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 sp"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="60dp"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/btn_widget_text_plus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/red"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- SEKCE: VZHLED                                                 -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="12dp"
            android:layout_marginTop="4dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_hide_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skrýt ikonu ze seznamu aplikací"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- TLAČÍTKA AKCE                                                 -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Uložit nastavení"
                android:textSize="16sp"
                android:backgroundTint="@color/red"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_update_now"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Aktualizovat data"
                android:textSize="16sp"
                android:backgroundTint="@color/red" />

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- TLAČÍTKA DEBUG                                                -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_show_log"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Zobrazit log"
                android:textSize="14sp"
                android:backgroundTint="@color/red"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_export_log"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Export log"
                android:textSize="14sp"
                android:backgroundTint="@color/red"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_clear_log"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Smazat log"
                android:textSize="14sp"
                android:backgroundTint="@color/red"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- ============================================================ -->
        <!-- STAV AKTUALIZACE                                              -->
        <!-- ============================================================ -->
        <TextView
            android:id="@+id/tv_last_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Poslední změna cen: --\nPoslední aktualizace: --"
            android:textSize="14sp"
            android:textColor="@color/grey_text"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/copylast_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autor: birgis 2026"
            android:textSize="12sp"
            android:textColor="@color/grey_text"
            android:gravity="center"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</ScrollView>
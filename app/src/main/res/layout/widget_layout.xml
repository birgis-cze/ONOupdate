<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="3dp"
    android:id="@+id/widget_root">

    <!-- HLAVIČKA – ŽLUTÁ, VLEVO LOGO, VPRAVO ČAS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/yellow"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="20dp"
            android:src="@drawable/logo"
            android:scaleType="fitStart"
            android:contentDescription="ONO" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="10sp"
            android:textColor="@color/red"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- ČERVENÁ ČÁRA – 80% šířky -->
    <View
        android:layout_width="80%"
        android:layout_height="2dp"
        android:background="@color/red"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp" />

    <!-- TĚLO WIDGETU – ŽLUTÉ POZADÍ, ČERVENÝ TEXT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/yellow"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp">

        <!-- N95 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="N95"
                android:textSize="11sp"
                android:textColor="@color/red"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/tv_n95_trend"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_equal"/>

            <TextView
                android:id="@+id/tv_n95"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="end"
                android:textColor="@color/red"/>
        </LinearLayout>

        <!-- N95+ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="N95+"
                android:textSize="11sp"
                android:textColor="@color/red"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/tv_n95p_trend"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_equal"/>

            <TextView
                android:id="@+id/tv_n95p"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="end"
                android:textColor="@color/red"/>
        </LinearLayout>

        <!-- Nafta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Nafta"
                android:textSize="11sp"
                android:textColor="@color/red"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/tv_nafta_trend"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_equal"/>

            <TextView
                android:id="@+id/tv_nafta"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="end"
                android:textColor="@color/red"/>
        </LinearLayout>

        <!-- LPG -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="LPG"
                android:textSize="11sp"
                android:textColor="@color/red"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/tv_lpg_trend"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_equal"/>

            <TextView
                android:id="@+id/tv_lpg"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="end"
                android:textColor="@color/red"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
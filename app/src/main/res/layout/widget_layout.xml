<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/yellow"
    android:padding="4dp">

    <!-- HLAVIČKA S LOGEM A ČASEM -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="32dp">

        <!-- 1. VRSTVA: Pozadí - linka pod logem i textem -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:src="@drawable/logo_linka"
            android:scaleType="fitXY"
            android:contentDescription="" />

        <!-- 2. VRSTVA: Obsah nad pozadím -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Logo vlevo s odstupem 1 znaku (8dp), sedí přímo na lince -->
            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentLeft="true"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="8dp"
                android:adjustViewBounds="true"
                android:src="@drawable/logo_text"
                android:contentDescription="ONO text" />

            <!-- Časový údaj vpravo, mírně nahoře nad linkou -->
            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="4dp"
                android:text="--:--"
                android:textSize="11sp"
                android:textColor="@color/red"
                android:textStyle="bold" />

        </RelativeLayout>

    </FrameLayout>

    <!-- CENY -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- N95 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="N95"
                android:textSize="11sp"
                android:textColor="@color/red"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/tv_n95_trend"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:textStyle="bold"
                android:src="@drawable/ic_arrow_equal"/>

            <TextView
                android:id="@+id/tv_n95"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="end"
                android:textColor="@color/red"/>
        </LinearLayout>


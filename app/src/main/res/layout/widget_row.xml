<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Název vlevo -->
    <TextView
        android:id="@+id/row_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:maxWidth="150dp"
        android:textColor="@color/ono_red"
        android:textStyle="bold"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="end"/>

    <!-- Trend vpravo -->
    <TextView
        android:id="@+id/row_trend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:textColor="@color/ono_red"
        android:textStyle="bold"
        android:textSize="14sp"
        android:singleLine="true"/>

    <!-- Aktuální cena vpravo před trendem -->
    <TextView
        android:id="@+id/row_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/row_trend"
        android:layout_centerVertical="true"
        android:paddingEnd="6dp"
        android:textColor="@color/ono_red"
        android:textStyle="bold"
        android:textSize="14sp"
        android:singleLine="true"/>

    <!-- Stará cena v závorce vlevo od aktuální ceny -->
    <TextView
        android:id="@+id/row_old"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/row_price"
        android:layout_centerVertical="true"
        android:paddingEnd="6dp"
        android:textColor="@color/ono_red"
        android:alpha="0.65"
        android:textSize="13sp"
        android:singleLine="true"/>
</RelativeLayout>